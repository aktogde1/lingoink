{
  "format": 1,
  "id": "a2_13",
  "title": "Comparatives & superlatives",
  "level": "A2",
  "kind": "grammar",
  "theory": [
    {
      "title": "ЦЕЛЬ И ПРАКТИКА",
      "lines": [
        "Сравнить предметы и выбрать лучший.",
        "Сначала примеры, затем задания и ответ без вариантов.",
        "Вспомните ответ до нажатия OK. Ошибки вернутся в этом занятии.",
        "Повторите материал в другой день через «Повторить»."
      ]
    },
    {
      "title": "СРАВНЕНИЕ: -ER / MORE",
      "lines": [
        "Короткие прилагательные:",
        "tall → taller → the tallest",
        "big → bigger (удвоение согласной)",
        "easy → easier (-y → -ier)",
        "",
        "Длинные (3+ слога):",
        "more expensive → the most expensive",
        "than — «чем»: cheaper than mine"
      ]
    },
    {
      "title": "ИСКЛЮЧЕНИЯ",
      "lines": [
        "good → better → the best",
        "bad → worse → the worst",
        "many / much → more → the most",
        "little → less → the least",
        "far → further → the furthest"
      ]
    },
    {
      "title": "ТИПИЧНЫЕ ОШИБКИ",
      "lines": [
        "✗ more bigger → ✓ bigger",
        "(-er И more сразу — нельзя)",
        "✗ the most easy → ✓ the easiest",
        "✗ more good → ✓ better",
        "",
        "the + превосходная степень:",
        "the best day, the tallest boy"
      ]
    }
  ],
  "exercises": [
