{
  "format": 1,
  "id": "a2_02",
  "title": "Present Perfect",
  "level": "A2",
  "kind": "grammar",
  "theory": [
    {
      "title": "PRESENT PERFECT",
      "lines": [
        "have / has + past participle",
        "",
        "Used when:",
        "• the result matters now",
        "• life experience (ever, never)",
        "• unfinished time (today, this week)",
        "",
        "I have lost my keys.  (they are still lost)",
        "She has never been to London.",
        "We have finished three lessons today."
      ]
    }
  ],
  "exercises": [
    {
      "type": "cloze",
      "prompt": "I ___ my keys. I can't open the door.",
      "options": ["have lost", "lost", "am losing", "lose"],
      "correct": 0,
      "srs": ["pp.form", "pp-vs-past"],
      "tags": ["present-perfect", "pp-vs-past"],
      "explain": "Результат важен сейчас: ключи до сих пор потеряны → Present Perfect."
    },
    {
      "type": "cloze",
      "prompt": "Yesterday I ___ to the store.",
      "options": ["went", "have gone", "go", "was going"],
      "correct": 0,
      "srs": ["ps.went", "pp-vs-past"],
      "tags": ["past-simple", "pp-vs-past"],
      "explain": "Yesterday — законченное время в прошлом → Past Simple, несмотря ни на что."
    },
    {
      "type": "mistake",
      "prompt": "She don't like coffee.",
      "options": ["don't → doesn't", "like → likes", "coffee → coffees", "no mistake"],
      "correct": 0,
      "srs": ["gd.does"],
      "tags": ["do-does"],
      "explain": "She/he/it + doesn't. Вторая ошибка (like → likes) не нужна: после doesn't глагол в исходной форме."
    },
    {
      "type": "cloze",
      "prompt": "___ you ever ___ to London? — в правильном порядке",
      "options": ["Have / been", "Did / go", "Are / going", "Do / be"],
      "correct": 0,
      "srs": ["pp.questions", "pp.form"],
      "tags": ["present-perfect"],
      "explain": "Опыт за жизнь (ever) → Have you ever been..."
    },
    {
      "type": "cloze",
      "prompt": "We ___ three lessons today.",
      "options": ["have finished", "finished", "finish", "are finishing"],
      "correct": 0,
      "srs": ["pp.form", "pp-vs-past"],
      "tags": ["present-perfect", "pp-vs-past"],
      "explain": "Today ещё не закончился → Present Perfect."
    },
    {
      "type": "mistake",
      "prompt": "I have seen him yesterday.",
      "options": ["have seen → saw", "him → he", "yesterday → tomorrow", "no mistake"],
      "correct": 0,
      "srs": ["pp-vs-past"],
      "tags": ["pp-vs-past"],
      "explain": "yesterday требует Past Simple: I saw him yesterday."
    }
  ]
}
